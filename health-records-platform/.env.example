# ─── Application ───────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# development | staging | production. Production forbids sandbox identity checks and the dev mailbox.
APP_ENV=development
NEXT_PUBLIC_PLATFORM_NAME=Continuum

# ─── Database ──────────────────────────────────────────────────────────────────
# Runtime connection. This role has NO table privileges of its own; every
# request switches to `authenticated` (RLS enforced) or `service_role`.
DATABASE_URL=postgres://continuum_app:continuum_dev_only@127.0.0.1:54329/continuum
# Migration owner. Never expose to the running app in production.
DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:54329/continuum
# Integration tests use a separate database that is reset on every run.
TEST_DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:54329/continuum_test
TEST_DATABASE_URL=postgres://continuum_app:continuum_dev_only@127.0.0.1:54329/continuum_test
# Set to false when migrating a Supabase project (roles/extensions exist there).
DB_LOCAL_COMPAT=true

# ─── Secrets (generate with: openssl rand -base64 32) ─────────────────────────
# AES-256-GCM key for stored files and MFA secrets.
APP_ENCRYPTION_KEY=
# HMAC key for hashing national identifiers (NIN). Rotating it requires re-hashing.
IDENTIFIER_HASH_KEY=
# Shared secret for the scheduled expiry endpoint.
CRON_SECRET=

# ─── File storage ─────────────────────────────────────────────────────────────
# local    = AES-256-GCM encrypted files on disk (development / single node)
# supabase = private Supabase Storage bucket
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=medical-records
# Optional ClamAV daemon for malware scanning (host:port). Strongly recommended for any pilot.
CLAMAV_ADDRESS=

# ─── Network & password safety ────────────────────────────────────────────────
# Number of trusted reverse proxies in front of the app (each appends to X-Forwarded-For).
# 0 = ignore forwarded headers. Set exactly; a wrong value lets clients spoof IPs or mis-attributes them.
TRUSTED_PROXY_HOPS=1
# hibp = reject passwords found in breaches via the k-anonymity range API (recommended in production); off = disabled
PASSWORD_BREACH_CHECK=off

# ─── Identity verification ────────────────────────────────────────────────────
# sandbox       = deterministic synthetic results (NEVER in production)
# manual_review = queued for platform staff
IDENTITY_PROVIDER=sandbox

# ─── Messaging ────────────────────────────────────────────────────────────────
# outbox = messages stay in message_outbox (view them at /dev/mailbox in development)
# log    = worker marks them sent and logs ids only (staging)
# smtp   = deliver via SMTP_URL (required in production)
MAIL_DRIVER=outbox
SMTP_URL=
MAIL_FROM="Continuum <no-reply@example.org>"
# none | log | termii | africastalking | webhook (generic JSON POST {to, message, reference})
SMS_DRIVER=none
# Termii: SMS_API_KEY + SMS_SENDER_ID (approved, for the DND route)
# Africa's Talking: SMS_API_KEY + SMS_USERNAME (+ optional SMS_SENDER_ID); sandbox: SMS_BASE_URL=https://api.sandbox.africastalking.com
SMS_API_KEY=
SMS_SENDER_ID=
SMS_USERNAME=
SMS_BASE_URL=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
ENABLE_DEV_MAILBOX=true
